<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Questrandomizer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.0.0</Version>
    <!-- Build straight into a droppable user/mods/<ModName> layout at the workspace root -->
    <OutputPath>..\dist\SPT\user\mods\$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.0.13" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.13" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.13" />
    <!-- LeavesUtils ships as its own separately-installed mod - compile against it, but don't copy a dll -->
    <ProjectReference Include="../Leaves-LeavesUtil/Leaves-LeavesUtil.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- SPTarkov.Reflection.dll is SPT's own thin wrapper around Harmony (see Patches/
         GetQuestsPatch.cs for what it's used for). It isn't published as a NuGet package - it
         only ships inside the actual server install - so it's referenced directly from there.
         Private=false means we don't copy our own redundant copy into this mod's output folder;
         the live server already has it loaded, and shipping a second copy risks a version
         mismatch with whatever Harmony patches SPT itself (or other mods) already applied. -->
    <Reference Include="SPTarkov.Reflection">
      <HintPath>G:\Tarkov\SPT-AKI\SPT-4.0.13\SPT\SPTarkov.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="config\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Unlike the other, simpler mods in this workspace, this one also ships a whole assets/
         folder (weapon/handover category data, misc data, per-language mod locale phrase banks)
         that config-only mods don't have - needs its own copy rule.

         assets/generated/** is deliberately EXCLUDED here. Those files (ids.jsonc, and every
         assets/generated/<profileId>/ folder) are runtime-owned - the live server writes fresh
         data into them via LeavesUtils.saveJsonFile as players actually generate quests. If they
         were included in this glob, every rebuild would re-copy the workspace's checked-in
         placeholder (an empty ids.jsonc, no profile folders at all) into dist/, and the
         CopyToTestServer step in Directory.Build.targets would then overwrite the live server's
         real, runtime-populated files with that stale placeholder - which is exactly what was
         happening: every rebuild silently reset ids.jsonc to empty, so newly-generated quest ids
         never matched what was already saved in a profile's cached quests.json, and those quests
         got needlessly re-rolled on every restart. The mod's own OnLoad code (see
         Questrandomizer.cs) already handles a missing/empty assets/generated/ gracefully, so nothing
         needs to ship there for a fresh install either. -->
    <None Include="assets\**" Exclude="assets\generated\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyToSecondaryLocation" AfterTargets="Build">
    <ItemGroup>
      <OutputFiles Include="$(OutputPath)**\*.*" />
    </ItemGroup>

    <!-- 1. Purge the ENTIRE previous _dist (old-version zips included) so a version bump doesn't
         leave stale zips behind and removed/renamed files don't stick round -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\_dist"
      Condition="Exists('$(MSBuildProjectDirectory)\_dist')" />

    <!-- 2. Copy fresh build output into the mod folder structure -->
    <Copy SourceFiles="@(OutputFiles)"
      DestinationFolder="$(MSBuildProjectDirectory)\_dist\SPT\user\mods\$(MSBuildProjectName)\%(RecursiveDir)"
      SkipUnchangedFiles="true" />

    <!-- 3. Zip the CONTENTS of _dist -->
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\_dist"
      DestinationFile="$(MSBuildProjectDirectory)\$(MSBuildProjectName)_$(Version).zip"
      Overwrite="true" />

    <!-- 4. Purge the loose folder, leaving only the zip -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\_dist\SPT" />

    <!-- 5. Move the finished zip into _dist -->
    <Move SourceFiles="$(MSBuildProjectDirectory)\$(MSBuildProjectName)_$(Version).zip"
      DestinationFiles="$(MSBuildProjectDirectory)\_dist\$(MSBuildProjectName)_$(Version).zip" />
  </Target>
</Project>