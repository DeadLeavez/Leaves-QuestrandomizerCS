{
    "questBlacklist": //These quests wont be edited. First batch are recommended to leave in here. Cus they cause bugs of different kinds when randomized.
    [
        "5c0d190cd09282029f5390d8", //Grenadier (Works fine to randomize, it just sort of loses its unique identity)
        "5d25e2d886f77442734d335e", //The Huntsman Path - Controller (Loses unique identity, and might cause hidden objectives)
        "60e729cf5698ee7b05057439", //Swift one
        "5d25bfd086f77442734d3007", //The Survivalist Path - Zhivchik
        "5d25c81b86f77443e625dd71", //The Survivalist Path - Wounded Beast
        "59675ea386f77414b32bded2", //Postman Pat - Part 1 (Can be randomized, but causes UI bugs.)
        "596760e186f7741e11214d58", //Postman Pat - Part 2 (Can be randomized, but causes UI bugs.)
        "5d25cf2686f77443e75488d4", //The Survivalist Path - Tough Guy, Works, but can become insanely difficult. 

        //Labyrinth quest line - blacklisted so this new map's quests stay untouched for now (remove these to let them randomize).
        "67a0970f05d1611ed90be75d", //Hypotheses Testing
        "67a09724972c11a3f5077324", //Confidential Info
        "67a0972e77dd677f600804bd", //This Tape Sucks
        "67a097379f2068e74603c6ac", //Indisputable Authority
        "67a09761e720611a6a01f288", //Keepers Word
        "67d03be712fb5f8fd2096332", //Vacate the Premises

        //"Enemy must be wearing gear X" quests - a hidden kill-condition filter (enemyEquipmentInclusive).
        //With gear-adding mods installed the target pool barely ever matches, and QR piling weapon/map/
        //bodypart rolls on top makes them impossible. Blacklisted so they stay vanilla (still annoying, but
        //doable). Already-active copies force-purge back to vanilla on next load (OutlineVerification).
        "6663149cfd5ca9577902e037", //The Invisible Hand (enemyEquipmentInclusive, 27 gear groups)
        "67503260899713ccad00060e", //Enough Drinks for That One (enemyEquipmentInclusive, 10 gear groups)
        //The other two only use enemyEquipmentExclusive with a single item (kill anyone NOT wearing it =
        //effectively unconstrained), so they aren't really a limitation - blacklisted anyway for consistency.
        "676c243577f0257dd50239e6", //The Price of Celebration (enemyEquipmentExclusive, 1 item)
        "676c243fb16f4b14b905e7f4" //This Is My Party (enemyEquipmentExclusive, 1 item)

    ],

    "chanceToEditKillConditions": 1.00, //Chance that we want to edit kill requirement on a quest. 1 for always. 0 for never. Decimal values are ok.
    "chanceToAddLocations": 0.50, //Chance to add a location requirement to kill quests.
    "locationCount": 2, //Total locations that the quest will be valid on.
    "factoryDayQuestsAlsoCountAtNight": true, //Factory - Day objectives also count at night (not the reverse). Widened objectives read "[Factory]". 
    "chanceToAddTimeOfDay": 0.05, //CHance to add a time of day requirement to kill quests.
    "timeOfDayWindowHours": 8, //Length in hours of a rolled time-of-day window (kills only count between From and From+this).
    "chanceToAddBodypart": 0.08, //Chance to add having to target specific body parts to kill quests.
    "chanceToAddDistance": 0.05, //Chance to add a distance requirement to kill quests. (Currently >=/<= 20-100m, Might add options for this later)
    "chanceToAddWeapon": 0.60, //Chance to add weapon requirement to kill quests. Will do a weighted selection from the weaponcategories.jsonc file.
    "chanceForSecondWeaponCategory": 0.15, //Chance a weapon requirement uses TWO categories ("an AK or an SMG") instead of one. Multi-category only combines mod-less categories, so it's weapons-only.
    "chanceForMysteryArsenal": 0.0, //Chance a weapon requirement is a "mystery arsenal": a fixed set of specific weapons instead of a category - one guaranteed pistol, one guaranteed shotgun, plus mysteryArsenalWeaponCount random weapons from the whole pool.
    "mysteryArsenalWeaponCount": 3, //How many random weapons a mystery arsenal adds ON TOP of the guaranteed pistol and shotgun.
    "chanceToAddGear": 0.10, //Chance to add gear requirement to kill quest. Will do a weighted selection from the gearlist.jsonc file.
    "chanceToEditGear": 0.3, //Chance to re-roll a gear requirement the quest ALREADY has (e.g. vanilla "kill wearing UNTAR gear" quests) into random gear from gearlist.jsonc. Only applies to the few quests that come with gear requirements.
    "addGearCount": 4, //How many different gear pieces will be selected. Every gear piece is an alternative. You only ever need to wear 1 of them.


    "adjustKillCountFactorsUpDown": [ 0.20, 0.20 ], //How many kills a quest will need. It's randomly increased/decreased by a multiplier between the factors. So default settings makes the multiplier between 0.8-1.2
    "killCountWhenTargetTypeChangesFactor": 1.5, //Ill tell how this works later. Idk

    "addKillObjectiveToQuestChance": 0.60, //Chance to add a kill objective to quests that don't naturally have them.
    "addKillObjectiveKillCount": 4, //Base kill count to added objectives. Then multiplied by the factors above.
    "addKillOBjectiveDepthFactor": 0.15, //Will add quest depth * factor to the total kill count. Depth is how many quests is before it.
    "addKillOBjectiveLevelFactor": 0.15, //Will add quest level * factor to the total kill count. Level is the minimum required level to start the quest.

    "addHandOverObjectiveToQuestChance": 0.35, //CHance to ADD a handover condition to a quest that does not have it.
    "addHandOverObjectiveBaseCount": 2, //Number of items that need to be handed over by default.
    "addHandOverObjectiveDepthFactor": 0.15, //Will add quest depth * factor to the total kill count. Depth is how many quests is before it.
    "addHandOverObjectiveLevelFactor": 0.1, //Will add quest level * factor to the total kill count. Level is the minimum required level to start the quest.

    "chanceToEditHandoverCondition": 0.85, //Chance that the handover part of a quest will be randomized. 1 for always. 0 for never. Decimal values are ok.
    "chanceToRequireItemCategory": 0.15, //Chance that instead of a specific item, the quest requires a bunch of items from a category instead.
    "itemCategoryMultiplier": 2.50, //If it's a category we multiply the needed item count with this. With default settings if a quest normally requires 5 Duct Tape, it now might require 10 medikits.
    "handoverItemUnknownItemValueDivider": 14000, //The divisor that determines the tier of an item. Rounded to nearest tier. An item worth 34000 rubles with be 34000/15000 ~ 2. Lower value means harder quests.
    "adjustHandoverCountFactorsUpDown": [ 0.25, 0.40 ], //Adjusts how many items are needed for a handover quest. See how it works above.
    "chanceHandoverNeedsFIR": 0.50, //Chance for a quest to require the handover items to be Found In Raid. 1 is always. 0 is never.
    "rainbowifyFIR": true, //IF set to false, will make the "found in raid" text no longer be rainbow.
    "handoverItemBlacklist": //Any quest that requires you to handover an item from this list will be skipped entirely and left alone. Parent categories also work.
    [
        "5696686a4bdc2da3298b456a", //Dollars
        "5449016a4bdc2d6f028b456f", //Roubles
        "569668774bdc2da2298b4568", //Euros
